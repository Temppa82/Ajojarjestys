<Window x:Class="AjoJarjestys.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AjoJärjestys v3.7" Height="780" Width="1280" MinHeight="650" MinWidth="1050" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Margin="0,0,0,14"><TextBlock Text="AJOJÄRJESTYS" FontSize="28" FontWeight="Bold"/><TextBlock Text="PDF-lähetteet → tarkistetut osoitteet → tieverkon mukaan optimoitu reitti" Foreground="Gray"/><TextBlock Text="v3.7 • Luoja: Teemu H. Fingerroos" Foreground="Gray" Margin="0,3,0,0"/></StackPanel><Border Grid.Row="1" BorderBrush="#B8B8B8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"><DockPanel><StackPanel Orientation="Horizontal"><Button Content="+ Lisää PDF:t" Width="125" Height="34" Margin="0,0,8,0" Click="AddPdf_Click"/><Button Content="Tyhjennä" Width="95" Height="34" Click="Clear_Click"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="Tai raahaa PDF-tiedostot tähän ikkunaan" VerticalAlignment="Center" Foreground="Gray"/></DockPanel></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions><DataGrid x:Name="StopsGrid" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="True" CanUserReorderColumns="True" AllowDrop="True" PreviewMouseMove="StopsGrid_MouseMove" MouseDoubleClick="StopsGrid_MouseDoubleClick" Drop="StopsGrid_Drop" RowHeaderWidth="0" Margin="0,0,12,0"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number}" Width="45" IsReadOnly="True"/><DataGridTextColumn Header="Lähete" Binding="{Binding FileName}" Width="170" IsReadOnly="True"/><DataGridTextColumn Header="Vastaanottaja" Binding="{Binding Recipient}" Width="180" IsReadOnly="True"/><DataGridTextColumn Header="Osoite" Binding="{Binding Address}" Width="*"/><DataGridCheckBoxColumn Header="✓" Binding="{Binding Accepted}" Width="45"/><DataGridTextColumn Header="Tila" Binding="{Binding Status}" Width="105" IsReadOnly="True"/></DataGrid.Columns></DataGrid><Border Grid.Column="1" BorderBrush="#B8B8B8" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="1. Osoitteiden tarkistus" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="ValidationSummary" Margin="0,8,0,12" TextWrapping="Wrap"/><TextBlock Text="Lähtöosoite" FontWeight="SemiBold"/>
<TextBox x:Name="StartAddressBox" Text="Itäinen valkoisenlähteentie 18, Vantaa" Height="30" Margin="0,5,0,10"/>
<TextBlock Text="Päivän pääteosoite" FontWeight="SemiBold"/>
<TextBox x:Name="EndAddressBox" Height="30" Margin="0,5,0,10"/>
<TextBlock Text="Esim. koti. Jos jätät tyhjäksi, reitti ei pakota päätepistettä." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/><Button Content="✓ Hyväksy valittu osoite" Height="34" Margin="0,0,0,7" Click="AcceptSelected_Click"/><Button Content="🔎 Tarkista / muokkaa valittua" Height="34" Margin="0,0,0,14" Click="EditSelected_Click"/><Separator Margin="0,0,0,14"/><TextBlock Text="2. Tieverkon optimointi" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="RouteSummary" Margin="0,8,0,10" TextWrapping="Wrap"/><Button x:Name="OptimizeButton" Content="OPTIMOI AJOREITTI" Height="42" FontWeight="Bold" Click="Optimize_Click"/><TextBlock Text="Internet-yhteys tarvitaan vain uusien osoitteiden ja reitin hakemiseen. Osoitteet tallennetaan paikalliseen välimuistiin." Margin="0,12,0,0" Foreground="Gray"/><Separator Margin="0,14,0,14"/><TextBlock Text="3. Lopputulos" FontSize="18" FontWeight="Bold"/><TextBlock Text="Voit raahata pysähdyksiä käsin optimoinnin jälkeen." Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid><DockPanel Grid.Row="3" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><TextBlock x:Name="CountText"/><TextBlock Text="   •   " Foreground="Gray"/><TextBlock x:Name="AcceptedText"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Tallenna järjestys" Width="145" Height="38" Margin="0,0,8,0" Click="SaveOrder_Click"/><Button Content="YHDISTÄ PDF:T" Width="150" Height="38" FontWeight="Bold" Click="MergePdf_Click"/></StackPanel></DockPanel></Grid></Window>