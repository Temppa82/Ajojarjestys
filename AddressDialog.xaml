<Window x:Class="AjoJarjestys.AddressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Tarkista lähete" Width="760" Height="720" MinWidth="650" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Tarkista lähete" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="FileText" Margin="0,4,0,10" Foreground="#666" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#D8DCE2" BorderThickness="1" CornerRadius="10" Padding="8">
            <Grid>
                <wv2:WebView2 x:Name="PdfPreview" Visibility="Collapsed" />
                <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                <TextBlock x:Name="PreviewStatus" Text="Ladataan PDF-esikatselua…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666" Background="#FFFFFF" Padding="12"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Vastaanottaja" FontWeight="SemiBold"/>
                <TextBox x:Name="RecipientBox" Height="34" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Osoite" FontWeight="SemiBold"/>
                <TextBox x:Name="AddressBox" Height="34" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="QueueText" VerticalAlignment="Center" Foreground="#666"/>
            <Button Grid.Column="1" Content="‹ Edellinen" Width="105" Margin="6,0" Click="Previous_Click"/>
            <Button Grid.Column="2" Content="Seuraava ›" Width="105" Margin="6,0" Click="Next_Click"/>
            <Button Grid.Column="3" Content="✓ Hyväksy" Width="110" Margin="6,0,0,0" Click="Accept_Click" Background="#2563EB" Foreground="White" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
